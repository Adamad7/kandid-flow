# ==============================================================================
# KandidFlow — Environment Configuration (.env.example)
# Copy this file to .env and replace placeholders with actual values.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=info

# Service Port Mappings & URLs
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
POSTGRES_PORT=5432
VITE_API_URL=http://localhost:8000

# PostgreSQL Database Configuration
POSTGRES_USER=kandid_user
POSTGRES_PASSWORD=kandid_secret_change_me
POSTGRES_DB=kandid_db
POSTGRES_HOST=db
# Full async SQLAlchemy connection string (if left unset, docker-compose derives it from POSTGRES_* above)
DATABASE_URL=postgresql+asyncpg://kandid_user:kandid_secret_change_me@db:5432/kandid_db

# Security & Extension Authentication
# Shared secret token for Browser Extension authentication with POST /api/v1/inbox
EXTENSION_API_TOKEN=kandid_dev_secret_token_replace_in_production_32chars
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM Orchestrator Configuration
# Options: auto_ollama_fallback_api, auto_ollama_only, auto_api_only, manual
AUTO_PARSE_MODE=auto_ollama_fallback_api

# Local Ollama Settings (host.docker.internal allows Docker container to reach host Ollama)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:14b

# Cloud API Fallback Settings
# Supported providers: gemini, openai
API_PROVIDER=gemini
API_MODEL=gemini-2.5-flash

# Cloud API Keys (required when AUTO_PARSE_MODE uses cloud fallback or cloud only)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
