# ==============================================================================
# KandidFlow — Environment Configuration (.env.example)
# Copy this file to .env and replace placeholders with actual values.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=info

# Service Port Mappings & URLs
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
POSTGRES_PORT=5432
VITE_API_URL=http://localhost:8000

# PostgreSQL Database Configuration
POSTGRES_USER=kandid_user
POSTGRES_PASSWORD=kandid_secret_change_me
POSTGRES_DB=kandid_db
POSTGRES_HOST=db
# Full async SQLAlchemy connection string (if left unset, docker-compose derives it from POSTGRES_* above)
DATABASE_URL=postgresql+asyncpg://kandid_user:kandid_secret_change_me@db:5432/kandid_db

# Security & Extension Authentication
# Shared secret token for Browser Extension authentication with POST /api/v1/inbox
EXTENSION_API_TOKEN=kandid_dev_secret_token_replace_in_production_32chars
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cloud API Keys (required when AUTO_PARSE_MODE uses cloud fallback or cloud only)
# Secrets must ONLY be configured here, NEVER stored in the database.
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ==============================================================================
# Initial Seed Configuration (Used ONLY during initial setup if DB is empty)
# NOTE: Modifying these values after the database is initialized has NO effect.
# Active runtime settings must be managed in the Web UI (Settings page).
# ==============================================================================
INITIAL_AUTO_PARSE_MODE=auto_ollama_fallback_api
INITIAL_OLLAMA_BASE_URL=http://host.docker.internal:11434
INITIAL_OLLAMA_MODEL=qwen2.5:14b
INITIAL_API_PROVIDER=gemini
INITIAL_API_MODEL=gemini-3.8-flash

# ==============================================================================
# AI Test Runner Configuration
# Options: local, cloud, mock
# - local: executes AI-dependent tests against local Ollama (OLLAMA_BASE_URL, OLLAMA_MODEL)
# - cloud: executes AI-dependent tests against Cloud API (API_PROVIDER, API_MODEL, GEMINI_API_KEY/OPENAI_API_KEY)
# - mock: executes tests with fast deterministic mocks (useful for offline CI runs)
# ==============================================================================
TEST_AI_PROVIDER=local
